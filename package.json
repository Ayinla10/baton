{
  "name": "baton",
  "version": "0.1.0",
  "description": "Detects drift between CLAUDE.md/AGENTS.md (or any shared multi-agent state file) and actual git history.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "bin": {
    "baton": "./bin/baton"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "pretest": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
